[Unit]
Description=Teams presence refresher (keeps the GNOME idle clock from tripping Teams "Away")
Documentation=file:%h/.local/share/teams-refresher/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/teams-refresher --threshold 180
Restart=on-failure
RestartSec=5
# Harmless hardening: this only ever needs the session bus and /dev/uinput.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict

[Install]
WantedBy=graphical-session.target
